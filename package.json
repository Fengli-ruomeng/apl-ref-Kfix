{
  "name": "apl_ref",
  "version": "0.7.5",
  "description": "APL's Ref Client",
  "main": "main.js",
  "scripts": {
    "start": "npm run ensure:mods && electron-forge start",
    "ensure:mods": "node scripts/ensureMods.js",
    "build:css": "tailwindcss -i ./src/renderer/css/tailwind-input.css -o ./src/renderer/css/tailwind.css --minify",
    "build:assets": "npm run ensure:mods && npm run build:css",
    "make": "npm run build:assets && electron-forge make",
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "npm run build:assets && electron-forge package",
    "gensources": "node scripts/updateSrc.js"
  },
  "author": "applearon",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/cli": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "electron": "^40.7.0",
    "electron-prebuilt-compile": "^8.2.0",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@logtape/file": "^2.1.1",
    "@logtape/logtape": "^2.1.1",
    "@microsoft/signalr": "^10.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "ws": "^8.19.0"
  }
}
